# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/regvue
# Neon (cloud): postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/regvue

# Server port (default 3001)
PORT=3001

# Environment
NODE_ENV=development

# Clerk auth (dashboard.clerk.com → API Keys)
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# Claude API — gap assessment (document/open/paid modes)
ANTHROPIC_API_KEY=sk-ant-xxx

# serper.dev — Google search fallback for custom-source regulations
SERPER_API_KEY=xxx

# Public URL of this deployment (used for absolute links, e.g. in emails)
RENDER_EXTERNAL_URL=https://regvue.app
